DB_SERVER=localhost\SQLEXPRESS
DB_NAME=DS_Votaciones
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Solo si DB_TRUSTED_CONNECTION=false (autenticacion SQL en vez de Windows):
# DB_USER=sa
# DB_PASSWORD=change-me

# Secreto para firmar los tokens de sesion (minimo 32 caracteres, obligatorio).
# Generarlo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=5736b2b2eead0619e356f5db64b6d2046e18419a65e04e1e7386c684945abff7
# JWT_EXPIRE_MINUTES=480

# Segunda base de datos (MongoDB Atlas) para el historial de auditoría.
# Cadena de conexion del cluster de Atlas, con usuario/clave de un usuario
# de base de datos (Database Access en Atlas, no tu cuenta de Atlas).
# Vacio = auditoría deshabilitada, el resto de la API funciona igual.
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
# MONGODB_DB=ds_votaciones_auditoria

# Job en segundo plano que abre/cierra votaciones segun su ventana de
# tiempo. Desactivalo (false) si vas a correr varias instancias de la API
# contra la misma BD, para que no compitan ejecutando el mismo job.
# ENABLE_SCHEDULER=true
